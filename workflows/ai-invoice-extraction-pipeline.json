      "name": "Note - PDF Text Extraction"
    },
    {
      "parameters": {
        "content": "✂️ Splits each PDF text into individual invoices using the repeated invoice header as a marker. Produces one n8n item per invoice/page.",
        "height": 416,
        "width": 166
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        432,
        -32
      ],
      "typeVersion": 1,
      "id": "cd28dd93-a0d5-47f8-baed-c30a2a8beaa6",
      "name": "Note - Invoice Splitting"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-4-5-20251001",
          "mode": "list",
          "cachedResultName": "claude-haiku-4-5-20251001"
        },
        "messages": {
          "values": [
            {
              "content": "=Extract the data from this invoice and return only valid JSON.\n\nInvoice text:\n{{ $json.raw_invoice_text }}\n\nUse exactly this schema:\n{\n  \"grower_name\": null,\n  \"grower_ruc\": null,\n  \"client_name\": null,\n  \"date\": null,\n  \"invoice_number\": null,\n  \"air_way_bill\": null,\n  \"house_air_way_bill\": null,\n  \"airline\": null,\n  \"items\": [],\n  \"total_amount\": null\n}"
            }
          ]
        },
        "options": {
          "system": "You are an invoice data extraction assistant. Return only valid JSON. Do not use Markdown. Do not include explanations or any text outside the JSON object. Convert numeric values to numbers without thousands separators."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        672,
        192
      ],
      "id": "1a683b4d-ec48-4cb9-9613-37bd40b473f0",
      "name": "Extract Structured Invoice Data",
      "credentials": {
        "anthropicApi": {
          "id": "RWTDqG3eDFN6lhkA",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "content": "🤖 AI DATA EXTRACTION\n\nClaude Haiku reads each invoice text block and extracts structured invoice data as valid JSON.",
        "height": 416,
        "width": 182
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        688,
        -32
      ],
      "typeVersion": 1,
      "id": "0f8d6aca-48f4-4716-b36a-37e62bee0828",
      "name": "Note - AI Extraction"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  let text = item.json.content?.[0]?.text || '';\n\n  text = text\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```$/i, '')\n    .trim();\n\n  const parsed = JSON.parse(text);\n\n  return {\n    json: {\n      page_number: index + 1,\n      ...parsed,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        192
      ],
      "id": "c1c00f07-a7b6-4fe7-bae3-6891d8c5245e",
      "name": "Parse and Normalize JSON"
    },
    {
      "parameters": {
        "content": "🧹 JSON NORMALIZATION\n\nParses the LLM text response into real n8n JSON and prepares the data for validation and database persistence.",
        "height": 416,
        "width": 182
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        976,
        -32
      ],
      "typeVersion": 1,
      "id": "773d6b3d-3c3b-4643-b9ba-d5775f4fb78a",
      "name": "Note - JSON Normalization"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst output = [];\n\nfor (const item of allItems) {\n  const input = item.json;\n\n  const fullText = input.text || '';\n  const totalPages = input.numpages || null;\n  const fileName = input.fileName || item.binary?.data?.fileName || null;\n\n  const markerRegex = /Grower Name & Address\\s+Foreign Purchaser/g;\n  const matches = [...fullText.matchAll(markerRegex)];\n\n  if (matches.length === 0) {\n    output.push({\n      json: {\n        file_name: fileName,\n        error: 'No invoices found using the expected document marker',\n      },\n    });\n    continue;\n  }\n\n  for (let index = 0; index < matches.length; index++) {\n    const start = matches[index].index;\n    const end = index + 1 < matches.length\n      ? matches[index + 1].index\n      : fullText.length;\n\n    output.push({\n      json: {\n        file_name: fileName,\n        page_number: index + 1,\n        total_pages: totalPages,\n        raw_invoice_text: fullText.slice(start, end).trim(),\n      },\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        192
      ],
      "id": "a786c356-0995-4c2a-91b1-5b48a0d5b6d6",
      "name": "Split Invoices into Items"
    },
    {
      "parameters": {
        "maxItems": 4
      },
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1232,
        496
      ],
      "id": "c69d0b27-d84b-4507-a643-586236e14919",
      "name": "Limit"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const invoiceId = item.json.id;\n\n  const raw =\n    typeof item.json.raw_json === 'string'\n      ? JSON.parse(item.json.raw_json)\n      : item.json.raw_json;\n\n  const invoiceItems = raw.items || [];\n\n  invoiceItems.forEach((line, index) => {\n    output.push({\n      json: {\n        invoice_id: invoiceId,\n        line_index: index + 1,\n        product: line.product ?? null,\n        boxes: line.boxes ?? null,\n        unit: line.unit ?? null,\n        pieces: line.pieces ?? null,\n        tariff_number: line.tariff_number ?? null,\n        bunches: line.bunches ?? null,\n        stems: line.stems ?? null,\n        unit_price: line.unit_price ?? null,\n        extended_price: line.extended_price ?? null,\n      },\n    });\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
